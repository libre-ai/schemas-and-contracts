{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/mission-handoff-binding.v1.schema.json",
  "title": "Libre AI mission-handoff-binding.v1 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "tenantId",
    "handoff",
    "specPackage",
    "acceptanceDigest",
    "acceptanceCriteria"
  ],
  "properties": {
    "schemaVersion": {
      "const": "libre-ai.mission-handoff-binding.v1"
    },
    "tenantId": {
      "$ref": "common.v1.schema.json#/$defs/tenantId"
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "documentDigest", "archiveReference"],
      "properties": {
        "schemaVersion": {
          "const": "libre-ai.agent-handoff.v2"
        },
        "id": {
          "$ref": "common.v1.schema.json#/$defs/urn"
        },
        "documentDigest": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "archiveReference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "digest", "mediaType"],
          "properties": {
            "id": {
              "$ref": "common.v1.schema.json#/$defs/urn"
            },
            "digest": {
              "$ref": "common.v1.schema.json#/$defs/sha256"
            },
            "mediaType": {
              "const": "application/json"
            }
          }
        }
      }
    },
    "specPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "version", "bodyDigest"],
      "properties": {
        "schemaVersion": {
          "const": "libre-ai.spec-package.v2"
        },
        "id": {
          "$ref": "common.v1.schema.json#/$defs/urn"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "bodyDigest": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "acceptanceDigest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/identifier"
      }
    }
  }
}
