      "id": "visibility-unknown",
      "operation": "evaluate",
      "args": {
        "policy": {
          "schemaVersion": "libre-ai.signalement-routing-policy.v1",
          "organization": "example-org",
          "policyId": "golden",
          "version": "1",
          "destinations": [
            {
              "id": "gh",
              "profileId": "github-issues/github.com/rest-2022-11-28",
              "target": {
                "kind": "github-repository",
                "owner": "example-org",
                "repository": "widgets"
              },
              "residency": "eu",
              "visibilitySource": "discovered"
            }
          ],
          "routingRules": [
            {
              "id": "r-app",
              "match": { "origin": "https://app.example.com" },
              "imposed": ["gh"],
              "optional": [],
              "selectable": [],
              "denied": []
            }
          ],
          "disclosureRules": [
            {
              "id": "x-public-media",
              "roles": ["screenshot", "video"],
              "when": { "visibility": "public" },
              "decision": "withhold"
            },
            {
              "id": "x-default",
              "roles": ["document", "screenshot", "video"],
              "when": { "always": true },
              "decision": "transmit"
            }
          ]
        },
        "input": {
          "observedOrigin": "https://app.example.com",
          "files": [
            {
              "path": "README.md",
              "role": "document",
              "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            },
            {
              "path": "media/screen-1.png",
              "role": "screenshot",
              "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
            }
          ],
          "discovered": {}
        }
      },
      "expected": {
        "ok": {
          "policyVersion": "1",
          "policyDigest": "de42a23d98ae680ab155453b6c5804a9d7f1a03376e556a1a526993d9d2ef0fd",
          "matchedRuleIds": ["r-app"],
          "destinations": [
            {
              "destinationId": "gh",
              "profileId": "github-issues/github.com/rest-2022-11-28",
              "routing": "imposed",
              "files": [
                { "path": "README.md", "decision": "withhold", "reason": "visibility-unknown" },
                {
                  "path": "media/screen-1.png",
                  "decision": "withhold",
                  "reason": "visibility-unknown"
                }
              ],
              "media": "withhold"
            }
          ],
          "override": "denied",
          "deniedCount": 0
        }
      },
      "rationale": "routing-policy SEMANTICS, Evaluation, Input and 5.1: a destination absent from discovered reads visibility unknown, and every file is withheld with visibility-unknown, whatever the rules say."
    },
