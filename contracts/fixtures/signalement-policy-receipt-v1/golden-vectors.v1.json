    {
      "id": "exact-origin",
      "operation": "evaluate",
      "args": {
        "policy": {
          "schemaVersion": "libre-ai.signalement-routing-policy.v1",
          "organization": "example-org",
          "policyId": "golden",
          "version": "1",
          "destinations": [
            {
              "id": "gh",
              "profileId": "github-issues/github.com/rest-2022-11-28",
              "target": {
                "kind": "github-repository",
                "owner": "example-org",
                "repository": "widgets"
              },
              "residency": "eu",
              "visibilitySource": "discovered"
            },
            {
              "id": "gl",
              "profileId": "gitlab-issues/gitlab.com/rest-v4",
              "target": { "kind": "gitlab-project", "projectPath": "example-group/widgets" },
              "residency": "eu",
              "visibilitySource": "discovered"
            },
            {
              "id": "jira",
              "profileId": "jira-cloud/cloud/rest-v3",
              "target": {
                "kind": "jira-project",
                "siteUrl": "https://example.atlassian.net",
                "projectKey": "WID"
              },
              "residency": "non-eu",
              "visibilitySource": "declared",
              "declaredVisibility": "private"
            }
          ],
          "routingRules": [
            {
              "id": "r-app",
              "match": { "origin": "https://app.example.com" },
              "imposed": ["gl"],
              "optional": ["jira"],
              "selectable": ["gh"],
              "denied": []
            }
          ],
          "disclosureRules": [
            {
              "id": "x-public-media",
              "roles": ["screenshot", "video"],
              "when": { "visibility": "public" },
              "decision": "withhold"
            },
            {
              "id": "x-non-eu-video",
              "roles": ["video"],
              "when": { "residency": "non-eu" },
              "decision": "withhold"
            },
            {
              "id": "x-default",
              "roles": ["document", "screenshot", "video"],
              "when": { "always": true },
              "decision": "transmit"
            }
          ]
        },
        "input": {
          "observedOrigin": "https://app.example.com",
          "files": [
            {
              "path": "README.md",
              "role": "document",
              "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
            },
            {
              "path": "media/clip-1.webm",
              "role": "video",
              "sha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
            },
            {
              "path": "media/screen-1.png",
              "role": "screenshot",
              "sha256": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
            }
          ],
          "discovered": { "gl": { "visibility": "private", "attachmentUpload": true } }
        }
      },
      "expected": {
        "ok": {
          "policyVersion": "1",
          "policyDigest": "1b44ae14e4d7160af31479a56944c0088fef19d0a639ce346c2df6708dfdd94c",
          "matchedRuleIds": ["r-app"],
          "destinations": [
            {
              "destinationId": "gl",
              "profileId": "gitlab-issues/gitlab.com/rest-v4",
              "routing": "imposed",
              "files": [
                { "path": "README.md", "decision": "transmit", "reason": null },
                { "path": "media/clip-1.webm", "decision": "transmit", "reason": null },
                { "path": "media/screen-1.png", "decision": "transmit", "reason": null }
              ],
              "media": "withhold"
            },
            {
              "destinationId": "jira",
              "profileId": "jira-cloud/cloud/rest-v3",
              "routing": "optional",
              "files": [
                { "path": "README.md", "decision": "transmit", "reason": null },
                { "path": "media/clip-1.webm", "decision": "withhold", "reason": "residency" },
                { "path": "media/screen-1.png", "decision": "transmit", "reason": null }
              ],
              "media": "withhold"
            }
          ],
          "override": "denied",
          "deniedCount": 0
        }
      },
      "rationale": "routing-policy SEMANTICS, Evaluation 1 (origin equal octet for octet), 2 (imposed and optional of the rule), 3 (override absent is denied: no selectable; sorted by destinationId), 5 (per file; jira is non-eu, so its video is withheld for residency)."
    },
