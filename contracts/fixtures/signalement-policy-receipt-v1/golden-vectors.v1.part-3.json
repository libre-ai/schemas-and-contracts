{
  "schemaVersion": "libre-ai.signalement-policy-receipt-golden-vectors.v1",
  "cases": [
    {
      "id": "canonicalize-sort-ascii",
      "operation": "canonicalize",
      "args": { "jsonBytes": "eyJiIjoxLCJhIjoyLCJCIjozLCJfIjo0fQ" },
      "expected": { "ok": { "B": 3, "_": 4, "a": 2, "b": 1 } },
      "rationale": "World SEMANTICS, canonicalize: members sorted by UTF-16 code units; output {\"B\":3,\"_\":4,\"a\":2,\"b\":1}."
    },
    {
      "id": "canonicalize-nested",
      "operation": "canonicalize",
      "args": {
        "jsonBytes": "eyAieiI6IHsgImIiOiBbMywgeyAiZCI6IDEsICJjIjogMiB9XSwgImEiOiBudWxsIH0sICJ5IjogdHJ1ZSB9"
      },
      "expected": { "ok": { "y": true, "z": { "a": null, "b": [3, { "c": 2, "d": 1 }] } } },
      "rationale": "World SEMANTICS, canonicalize: every object is sorted at every depth, array order kept, whitespace removed; output {\"y\":true,\"z\":{\"a\":null,\"b\":[3,{\"c\":2,\"d\":1}]}}."
    },
    {
      "id": "canonicalize-non-ascii-literal",
      "operation": "canonicalize",
      "args": { "jsonBytes": "eyJrIjoiXHUwMGU5XHU2NWU1XHU2NzJjIn0" },
      "expected": { "ok": { "k": "é日本" } },
      "rationale": "World SEMANTICS, canonicalize: non-ASCII characters are written as UTF-8, never escaped; output {\"k\":\"<U+00E9 U+65E5 U+672C as UTF-8>\"}."
    },
    {
      "id": "canonicalize-control-escape",
      "operation": "canonicalize",
      "args": { "jsonBytes": "Ilx1MDAxRlwvXHUwMDQxXHQi" },
      "expected": { "ok": "\u001f/A\t" },
      "rationale": "World SEMANTICS, canonicalize: U+001F is written \\u001f in lowercase hexadecimal, tab as \\t, the solidus and A unescaped; output \"\\u001f/A\\t\"."
    },
    {
      "id": "canonicalize-utf16-key-order",
      "operation": "canonicalize",
      "args": { "jsonBytes": "eyJcdWZmMjEiOjEsIlx1ZDgzZFx1ZGUwMCI6Mn0" },
      "expected": { "ok": { "😀": 2, "Ａ": 1 } },
      "rationale": "World SEMANTICS, canonicalize: keys compare by UTF-16 code units, so U+1F600 (D83D DE00) sorts before U+FF21, unlike code point order."
    },
    {
      "id": "canonicalize-safe-integer",
      "operation": "canonicalize",
      "args": { "jsonBytes": "WzkwMDcxOTkyNTQ3NDA5OTEsLTkwMDcxOTkyNTQ3NDA5OTEsMF0" },
      "expected": { "ok": [9007199254740991, -9007199254740991, 0] },
      "rationale": "World SEMANTICS, canonicalize: integers of magnitude at most 2^53 - 1 are written in decimal; output [9007199254740991,-9007199254740991,0]."
    },
    {
      "id": "canonicalize-integral-forms",
      "operation": "canonicalize",
      "args": { "jsonBytes": "WzEuMCwxZTIsLTAsMTBFLTFd" },
      "expected": { "ok": [1, 100, 0, 1] },
      "rationale": "World SEMANTICS, canonicalize: a number is read as binary64; an integral value of magnitude at most 2^53 - 1 is accepted whatever its literal and written as a plain integer, -0 as 0; output [1,100,0,1]."
    },
    {
      "id": "canonicalize-float",
      "operation": "canonicalize",
      "args": { "jsonBytes": "WzEuNV0" },
      "expected": { "error": { "code": "canonicalize.number" } },
      "rationale": "World SEMANTICS, canonicalize: 1.5 is not integral."
    },
    {
      "id": "canonicalize-two-pow-53",
      "operation": "canonicalize",
      "args": { "jsonBytes": "OTAwNzE5OTI1NDc0MDk5Mg" },
      "expected": { "error": { "code": "canonicalize.number" } },
      "rationale": "World SEMANTICS, canonicalize: 2^53 is above 2^53 - 1."
    },
    {
      "id": "canonicalize-non-finite",
      "operation": "canonicalize",
      "args": { "jsonBytes": "WzFlNDAwXQ" },
      "expected": { "error": { "code": "canonicalize.raw_json" } },
      "rationale": "World SEMANTICS, canonicalize: a literal whose binary64 value is not finite is not strict JSON."
    },
    {
      "id": "canonicalize-duplicate-member",
      "operation": "canonicalize",
      "args": { "jsonBytes": "eyJhIjoxLCJhIjoyfQ" },
      "expected": { "error": { "code": "canonicalize.raw_json" } },
      "rationale": "World SEMANTICS, canonicalize: a duplicate member name is not strict JSON."
    },
    {
      "id": "canonicalize-byte-order-mark",
      "operation": "canonicalize",
      "args": { "jsonBytes": "77u_MQ" },
      "expected": { "error": { "code": "canonicalize.raw_json" } },
      "rationale": "World SEMANTICS, canonicalize: a byte order mark is refused."
    },
    {
      "id": "canonicalize-lone-surrogate",
      "operation": "canonicalize",
      "args": { "jsonBytes": "WyJcdWQ4MDAiXQ" },
      "expected": { "error": { "code": "canonicalize.lone_surrogate" } },
      "rationale": "World SEMANTICS, canonicalize: an escaped high surrogate without its low surrogate."
    },
    {
      "id": "canonicalize-depth-65",
      "operation": "canonicalize",
      "args": {
        "jsonBytes": "W1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tdXV1dXV1dXV1dXV1dXV1dXV1dXV1dXV1dXV1dXV1dXV1dXV1dXV1dXV1dXV1dXV1dXV1dXV1dXV1dXV1dXV1dXQ"
      },
      "expected": { "error": { "code": "canonicalize.depth" } },
      "rationale": "World SEMANTICS, canonicalize: 65 nested arrays; the deepest value has depth 65, above 64."
    },
