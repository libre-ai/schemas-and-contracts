    {
      "id": "cds-sealed-frame-without-sender",
      "repository": "libre-ai/collaborative-data-sync",
      "revision": "8c50e51f7c2c7c255fff9c1e18a6596933ac3606",
      "locations": [
        "packages/core/src/crypto-types.ts:33-38",
        "packages/relay/src/relay-server.ts:51-52"
      ],
      "statement": "SealedFrame carries epoch, nonce, ciphertext and tag only: no MLSMessage wire format, no sender, no FramedContentAuthData signature. The relay documentation states that recipients trust the AEAD tag for identity. Under I-34 such a frame is refused as content outside the MLS framing.",
