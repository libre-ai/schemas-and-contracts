{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/execution-authorization.v4.schema.json",
  "title": "Libre AI execution-authorization.v4 candidate",
  "description": "Authorizes an execution-plan-body.v4 plan, contract only. Activation condition (ADR-0045 decision 4): while this contract is a candidate, a v4 authorization activates nothing, and no harness executes a v4 plan before the reference oracle tools/quality/execution-plan-body-v4.ts, or that harness itself, passes the 33 red vectors of contracts/fixtures/execution-plan-body-v4/red-vectors.json (SEMANTICS.md).",
  "$defs": {
    "successorBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionTransferId",
        "executionTransferDigest",
        "predecessorRunId",
        "predecessorPlanDigest",
        "sealedRevision",
        "terminalEffectInventoryDigest"
      ],
      "properties": {
        "executionTransferId": {
          "$ref": "common.v1.schema.json#/$defs/urn"
        },
        "executionTransferDigest": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "predecessorRunId": {
          "$ref": "common.v1.schema.json#/$defs/urn"
        },
        "predecessorPlanDigest": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "sealedRevision": {
          "$ref": "common.v1.schema.json#/$defs/revision"
        },
        "terminalEffectInventoryDigest": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "organizationId",
    "missionId",
    "missionRevision",
    "missionRecordDigest",
    "planId",
    "planDigest",
    "graphDigest",
    "planQuorum",
    "generation",
    "lineageMode",
    "successorBinding",
    "revocationId",
    "issuedAt",
    "expiresAt",
    "authorizationDigest",
    "missionRecordSchemaVersion",
    "planSchemaVersion",
    "handoffBindingDigest",
    "harnessProfileSchemaVersion",
    "harnessProfileDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "libre-ai.execution-authorization.v4"
    },
    "id": {
      "$ref": "common.v1.schema.json#/$defs/urn"
    },
    "organizationId": {
      "$ref": "common.v1.schema.json#/$defs/tenantId"
    },
    "missionId": {
      "$ref": "common.v1.schema.json#/$defs/urn"
    },
    "missionRevision": {
      "$ref": "common.v1.schema.json#/$defs/revision"
    },
    "missionRecordDigest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "planId": {
      "$ref": "common.v1.schema.json#/$defs/urn"
    },
    "planDigest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "graphDigest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "planQuorum": {
      "$ref": "common.v1.schema.json#/$defs/artifactReference"
    },
    "protectedHumanGate": {
      "$ref": "common.v1.schema.json#/$defs/approvalReference"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "lineageMode": {
      "enum": ["initial", "successor"]
    },
    "successorBinding": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/successorBinding"
        }
      ]
    },
    "revocationId": {
      "$ref": "common.v1.schema.json#/$defs/urn"
    },
    "issuedAt": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "expiresAt": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "authorizationDigest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "missionRecordSchemaVersion": {
      "const": "libre-ai.mission-record.v3"
    },
    "planSchemaVersion": {
      "const": "libre-ai.execution-plan-body.v4"
    },
    "handoffBindingDigest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "harnessProfileSchemaVersion": {
      "description": "The plan's harnessProfile resolves to a harness-profile.v3 document, the only major that declares k and w (ADR-0046 Q1); harnessProfileDigest is its profileDigest and equals the plan's harnessProfile.digest. planDigest is the v4 plan bodyDigest, whose RFC 8785 preimage covers isolation and steps.",
      "const": "libre-ai.harness-profile.v3"
    },
    "harnessProfileDigest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "lineageMode": {
            "const": "initial"
          }
        },
        "required": ["lineageMode"]
      },
      "then": {
        "type": "object",
        "properties": {
          "generation": {
            "const": 1
          },
          "successorBinding": {
            "type": "null"
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "generation": {
            "type": "integer",
            "minimum": 2
          },
          "successorBinding": {
            "$ref": "#/$defs/successorBinding"
          }
        }
      }
    }
  ]
}
