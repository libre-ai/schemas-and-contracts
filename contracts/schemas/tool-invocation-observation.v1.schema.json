{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/tool-invocation-observation.v1.schema.json",
  "title": "Libre AI ToolInvocationObservation v1",
  "description": "Candidate. One harness-attested window of consecutive tool calls made inside one worker invocation, aggregated by distinct (tool, keyed argument digest, keyed result digest, outcome). Carries no argument, no result and no business identifier. Decision: libre-ai/project-governance ADR-0046 (proposed). Semantics: contracts/tool-invocation-observation-v1/SEMANTICS.md.",
  "$defs": {
    "callSequence": { "type": "integer", "minimum": 1, "maximum": 100000 },
    "minuteTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:00Z$"
    },
    "digestKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "scope", "algorithm", "canonicalization"],
      "properties": {
        "keyId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "scope": { "const": "run" },
        "algorithm": { "const": "hmac-sha-256" },
        "canonicalization": { "const": "rfc8785-jcs" }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "windowSize", "firstCallSequence", "lastCallSequence", "final"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "windowSize": { "type": "integer", "minimum": 2, "maximum": 1024 },
        "firstCallSequence": { "$ref": "#/$defs/callSequence" },
        "lastCallSequence": { "$ref": "#/$defs/callSequence" },
        "final": { "type": "boolean" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "toolName",
        "argsDigest",
        "resultDigest",
        "outcome",
        "count",
        "firstCallSequence",
        "lastCallSequence"
      ],
      "properties": {
        "toolName": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "argsDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "resultDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
        "outcome": { "enum": ["ok", "empty", "error"] },
        "count": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "firstCallSequence": { "$ref": "#/$defs/callSequence" },
        "lastCallSequence": { "$ref": "#/$defs/callSequence" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "organizationId",
    "missionId",
    "planDigest",
    "graphDigest",
    "runId",
    "generation",
    "stepId",
    "attemptId",
    "workerInvocationId",
    "harnessAttestationDigest",
    "digestKey",
    "window",
    "previousObservationDigest",
    "entries",
    "closedAt",
    "signingKeyId",
    "preimageDigest",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "libre-ai.tool-invocation-observation.v1" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "organizationId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "missionId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "planDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "graphDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "runId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "generation": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
    "stepId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "attemptId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "workerInvocationId": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "harnessAttestationDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "digestKey": { "$ref": "#/$defs/digestKey" },
    "window": { "$ref": "#/$defs/window" },
    "previousObservationDigest": {
      "oneOf": [{ "type": "null" }, { "$ref": "common.v1.schema.json#/$defs/sha256" }]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/entry" }
    },
    "closedAt": { "$ref": "#/$defs/minuteTimestamp" },
    "signingKeyId": { "$ref": "common.v1.schema.json#/$defs/identifier" },
    "preimageDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "minLength": 86,
      "maxLength": 86
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "window": {
            "type": "object",
            "properties": { "sequence": { "const": 1 } },
            "required": ["sequence"]
          }
        },
        "required": ["window"]
      },
      "then": {
        "type": "object",
        "properties": { "previousObservationDigest": { "type": "null" } }
      },
      "else": {
        "type": "object",
        "properties": {
          "previousObservationDigest": { "$ref": "common.v1.schema.json#/$defs/sha256" }
        }
      }
    }
  ]
}
