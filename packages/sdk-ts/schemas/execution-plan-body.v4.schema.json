{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/execution-plan-body.v4.schema.json",
  "title": "Libre AI execution-plan-body.v4 candidate",
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._@*+-]+(?:/[A-Za-z0-9._@*+-]+)*$",
      "minLength": 1,
      "maxLength": 512
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "host", "port"],
      "properties": {
        "scheme": {
          "const": "https"
        },
        "host": {
          "type": "string",
          "pattern": "^(?=.{1,253}$)(?!localhost$)(?!.*\\.localhost$)(?!.*\\.local$)(?![0-9.]+$)(?!-)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)*[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "successorLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessorRunId",
        "predecessorPlanDigest",
        "sealedRevision",
        "terminalEffectInventoryDigest",
        "executionTransferId"
      ],
      "properties": {
        "predecessorRunId": {
          "$ref": "common.v1.schema.json#/$defs/urn"
        },
        "predecessorPlanDigest": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "sealedRevision": {
          "$ref": "common.v1.schema.json#/$defs/revision"
        },
        "terminalEffectInventoryDigest": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "executionTransferId": {
          "$ref": "common.v1.schema.json#/$defs/urn"
        }
      }
    },
    "quarantineClosedField": {
      "description": "One field of a quarantine output. Every kind is a closed vocabulary (ADR-0045 INV-c): there is no free-text kind.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "kind": {
          "enum": ["enum", "identifier", "boolean", "integer"]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          }
        },
        "referential": {
          "$ref": "common.v1.schema.json#/$defs/artifactReference"
        },
        "minimum": {
          "type": "integer",
          "minimum": -1000000000,
          "maximum": 1000000000
        },
        "maximum": {
          "type": "integer",
          "minimum": -1000000000,
          "maximum": 1000000000
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "enum"
            },
            "values": true,
            "referential": false,
            "minimum": false,
            "maximum": false
          },
          "required": ["values"]
        },
        {
          "properties": {
            "kind": {
              "const": "identifier"
            },
            "referential": true,
            "values": false,
            "minimum": false,
            "maximum": false
          },
          "required": ["referential"]
        },
        {
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "values": false,
            "referential": false,
            "minimum": false,
            "maximum": false
          }
        },
        {
          "properties": {
            "kind": {
              "const": "integer"
            },
            "minimum": true,
            "maximum": true,
            "values": false,
            "referential": false
          },
          "required": ["minimum", "maximum"]
        }
      ]
    },
    "quarantineOutput": {
      "description": "Closed-vocabulary output of a quarantine step (ADR-0045 INV-c). A failure or a lack of information is one of failureCodes, never text.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "failureCodes"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/quarantineClosedField"
          }
        },
        "failureCodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          }
        }
      }
    },
    "untrustedArgumentAdmission": {
      "description": "The only way a value of untrusted provenance may reach a parameter of this tool: a closed field of an earlier quarantine step (ADR-0045 INV-b).",
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "sourceStepId", "sourceField"],
      "properties": {
        "parameter": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "sourceStepId": {
          "$ref": "common.v1.schema.json#/$defs/urn"
        },
        "sourceField": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        }
      }
    },
    "planStepTool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "access",
        "effectClass",
        "argumentPolicyDigest",
        "untrustedArgumentAdmissions",
        "maxCalls"
      ],
      "properties": {
        "name": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "access": {
          "enum": ["read", "write", "execute", "network"]
        },
        "effectClass": {
          "enum": ["none", "effect"]
        },
        "argumentPolicyDigest": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        },
        "untrustedArgumentAdmissions": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/untrustedArgumentAdmission"
          }
        },
        "maxCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      },
      "if": {
        "properties": {
          "access": {
            "const": "read"
          }
        },
        "required": ["access"]
      },
      "then": {
        "properties": {
          "effectClass": {
            "const": "none"
          }
        }
      },
      "else": {
        "properties": {
          "effectClass": {
            "const": "effect"
          }
        }
      }
    },
    "stepInputOrigin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "trusted-request"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "contentRef"],
          "properties": {
            "kind": {
              "const": "untrusted-content"
            },
            "contentRef": {
              "$ref": "common.v1.schema.json#/$defs/artifactReference"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "stepId"],
          "properties": {
            "kind": {
              "const": "step-output"
            },
            "stepId": {
              "$ref": "common.v1.schema.json#/$defs/urn"
            }
          }
        }
      ]
    },
    "planStepInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputId", "source", "provenance", "delivery"],
      "properties": {
        "inputId": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "source": {
          "$ref": "#/$defs/stepInputOrigin"
        },
        "provenance": {
          "enum": ["trusted", "untrusted"]
        },
        "delivery": {
          "enum": ["in-context", "opaque-reference"]
        }
      },
      "if": {
        "properties": {
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "trusted-request"
              }
            },
            "required": ["kind"]
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "provenance": {
            "const": "trusted"
          }
        }
      },
      "else": {
        "properties": {
          "provenance": {
            "const": "untrusted"
          }
        }
      }
    },
    "planStep": {
      "description": "Binding of one authorized graph step to its role, tools and inputs (ADR-0045 INV-a, INV-c).",
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "role", "tools", "inputs"],
      "properties": {
        "stepId": {
          "$ref": "common.v1.schema.json#/$defs/urn"
        },
        "role": {
          "enum": ["privileged", "quarantine"]
        },
        "tools": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/planStepTool"
          }
        },
        "inputs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/planStepInput"
          }
        },
        "quarantineOutput": {
          "$ref": "#/$defs/quarantineOutput"
        }
      },
      "oneOf": [
        {
          "properties": {
            "role": {
              "const": "privileged"
            },
            "quarantineOutput": false,
            "inputs": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "if": {
                  "type": "object",
                  "properties": {
                    "provenance": {
                      "const": "untrusted"
                    }
                  },
                  "required": ["provenance"]
                },
                "then": {
                  "properties": {
                    "delivery": {
                      "const": "opaque-reference"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "properties": {
            "role": {
              "const": "quarantine"
            },
            "tools": {
              "type": "array",
              "maxItems": 0
            },
            "quarantineOutput": true
          },
          "required": ["quarantineOutput"]
        }
      ]
    },
    "planIsolation": {
      "description": "ADR-0045 decisions 2, 5 and 6, as constants a plan cannot weaken.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "realization",
        "toolResultDelivery",
        "argumentPolicyAuthority",
        "argumentPolicyEvaluation",
        "argumentPolicyRefusal"
      ],
      "properties": {
        "realization": {
          "enum": ["plan-then-execute", "action-selector"]
        },
        "toolResultDelivery": {
          "const": "opaque-reference"
        },
        "argumentPolicyAuthority": {
          "const": "agent-harness"
        },
        "argumentPolicyEvaluation": {
          "const": "per-argument-with-implicit-dependencies"
        },
        "argumentPolicyRefusal": {
          "const": "fail-closed-terminal"
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "organizationId",
    "missionId",
    "executionGraph",
    "lineageMode",
    "successorLineage",
    "requestedGeneration",
    "decisionSchemaRefs",
    "executorProfileRefs",
    "acceptanceCriteria",
    "isolation",
    "steps",
    "filesystem",
    "budgets",
    "network",
    "modelEgress",
    "harnessProfile",
    "workerManifests",
    "evidenceDestinations",
    "createdAt",
    "expiresAt",
    "bodyDigest",
    "handoffBindingSchemaVersion",
    "handoffBindingDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "libre-ai.execution-plan-body.v4"
    },
    "id": {
      "$ref": "common.v1.schema.json#/$defs/urn"
    },
    "organizationId": {
      "$ref": "common.v1.schema.json#/$defs/tenantId"
    },
    "missionId": {
      "$ref": "common.v1.schema.json#/$defs/urn"
    },
    "executionGraph": {
      "$ref": "common.v1.schema.json#/$defs/artifactReference"
    },
    "lineageMode": {
      "enum": ["initial", "successor"]
    },
    "successorLineage": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/successorLineage"
        }
      ]
    },
    "requestedGeneration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "decisionSchemaRefs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/artifactReference"
      }
    },
    "executorProfileRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/artifactReference"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/identifier"
      }
    },
    "isolation": {
      "$ref": "#/$defs/planIsolation"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/planStep"
      }
    },
    "filesystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readPaths", "writePaths", "denyPaths", "copyIgnoredFiles"],
      "properties": {
        "readPaths": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "writePaths": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "denyPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "copyIgnoredFiles": {
          "const": false
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxDurationSeconds",
        "maxToolCalls",
        "maxInputTokens",
        "maxOutputTokens",
        "maxProcesses",
        "maxFilesChanged",
        "maxChangedBytes",
        "maxConcurrentAgents"
      ],
      "properties": {
        "maxDurationSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "maxInputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "maxProcesses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "maxFilesChanged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "maxChangedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "maxConcurrentAgents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workerMode", "gatewayOrigins"],
      "properties": {
        "workerMode": {
          "enum": ["none", "private-gateway-only"]
        },
        "gatewayOrigins": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/origin"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "workerMode": {
                "const": "none"
              }
            },
            "required": ["workerMode"]
          },
          "then": {
            "type": "object",
            "properties": {
              "gatewayOrigins": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "workerMode": {
                "const": "private-gateway-only"
              }
            },
            "required": ["workerMode"]
          },
          "then": {
            "type": "object",
            "properties": {
              "gatewayOrigins": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "modelEgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purposeCode",
        "authorizationBasis",
        "maximumClassification",
        "sourcePaths",
        "maxBytesPerRequest",
        "region",
        "subprocessors",
        "zeroDataRetention",
        "trainingAllowed",
        "reuseAllowed",
        "policyDigest"
      ],
      "properties": {
        "purposeCode": {
          "$ref": "common.v1.schema.json#/$defs/identifier"
        },
        "authorizationBasis": {
          "enum": ["contract", "consent", "legitimate-interest", "public-task", "not-applicable"]
        },
        "maximumClassification": {
          "enum": ["public", "internal", "tenant-private", "personal"]
        },
        "sourcePaths": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/relativePath"
          }
        },
        "maxBytesPerRequest": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10485760
        },
        "region": {
          "enum": ["local", "france", "eu"]
        },
        "subprocessors": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "common.v1.schema.json#/$defs/identifier"
          }
        },
        "zeroDataRetention": {
          "const": true
        },
        "trainingAllowed": {
          "const": false
        },
        "reuseAllowed": {
          "const": false
        },
        "policyDigest": {
          "$ref": "common.v1.schema.json#/$defs/sha256"
        }
      }
    },
    "harnessProfile": {
      "$ref": "common.v1.schema.json#/$defs/artifactReference"
    },
    "workerManifests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/artifactReference"
      }
    },
    "evidenceDestinations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "common.v1.schema.json#/$defs/artifactReference"
      }
    },
    "createdAt": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "expiresAt": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "bodyDigest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    },
    "handoffBindingSchemaVersion": {
      "const": "libre-ai.mission-handoff-binding.v1"
    },
    "handoffBindingDigest": {
      "$ref": "common.v1.schema.json#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "lineageMode": {
            "const": "initial"
          }
        },
        "required": ["lineageMode"]
      },
      "then": {
        "type": "object",
        "properties": {
          "requestedGeneration": {
            "const": 1
          },
          "successorLineage": {
            "type": "null"
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "requestedGeneration": {
            "type": "integer",
            "minimum": 2
          },
          "successorLineage": {
            "$ref": "#/$defs/successorLineage"
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "network": {
            "type": "object",
            "properties": {
              "workerMode": {
                "const": "none"
              }
            },
            "required": ["workerMode"]
          }
        },
        "required": ["network"]
      },
      "then": {
        "type": "object",
        "properties": {
          "modelEgress": {
            "type": "object",
            "properties": {
              "authorizationBasis": {
                "const": "not-applicable"
              },
              "sourcePaths": {
                "type": "array",
                "maxItems": 0
              },
              "maxBytesPerRequest": {
                "const": 0
              },
              "region": {
                "const": "local"
              },
              "subprocessors": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "modelEgress": {
            "type": "object",
            "properties": {
              "authorizationBasis": {
                "enum": ["contract", "consent", "legitimate-interest", "public-task"]
              },
              "sourcePaths": {
                "type": "array",
                "minItems": 1
              },
              "maxBytesPerRequest": {
                "type": "integer",
                "minimum": 1
              },
              "region": {
                "enum": ["france", "eu"]
              },
              "subprocessors": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "isolation": {
            "type": "object",
            "properties": {
              "realization": {
                "const": "action-selector"
              }
            },
            "required": ["realization"]
          }
        },
        "required": ["isolation"]
      },
      "then": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "const": "privileged"
                },
                "inputs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "provenance": {
                        "const": "trusted"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
