{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/usage-statement.v1.schema.json",
  "title": "Libre AI Usage Statement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "organizationId", "period", "counters", "digest", "signature"],
  "properties": {
    "schemaVersion": { "const": "libre-ai.usage-statement.v1" },
    "organizationId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string", "format": "date-time", "maxLength": 32 },
        "to": { "type": "string", "format": "date-time", "maxLength": 32 }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "itemsRetained", "fetches", "members"],
      "properties": {
        "sources": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "itemsRetained": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "fetches": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "members": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "digest": { "$ref": "common.v1.schema.json#/$defs/sha256" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kid", "signature"],
      "properties": {
        "kid": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  }
}
