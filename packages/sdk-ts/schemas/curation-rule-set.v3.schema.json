{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/curation-rule-set.v3.schema.json",
  "title": "Libre AI Curation Rule Set v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "organizationId", "version", "status", "rules", "createdAt"],
  "properties": {
    "schemaVersion": { "const": "libre-ai.curation-rule-set.v3" },
    "id": { "$ref": "common.v1.schema.json#/$defs/urn" },
    "organizationId": { "$ref": "common.v1.schema.json#/$defs/tenantId" },
    "version": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "status": { "enum": ["draft", "active", "retired"] },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/rule" }
    },
    "createdAt": { "$ref": "common.v1.schema.json#/$defs/timestamp" }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "when", "then", "explanation"],
      "properties": {
        "id": { "$ref": "common.v1.schema.json#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "when": { "$ref": "#/$defs/condition4" },
        "then": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/action" }
        },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "leaf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "operator", "value"],
      "properties": {
        "field": {
          "enum": [
            "title",
            "content",
            "author",
            "url",
            "sourceHost",
            "language",
            "categories",
            "publishedAt",
            "collectedAt"
          ]
        },
        "operator": { "enum": ["equals", "contains", "prefix", "suffix", "after", "before"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 500 }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": { "field": { "enum": ["publishedAt", "collectedAt"] } },
            "required": ["field"]
          },
          "then": {
            "type": "object",
            "properties": {
              "operator": { "enum": ["after", "before"] },
              "value": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              }
            }
          },
          "else": {
            "type": "object",
            "properties": { "operator": { "enum": ["equals", "contains", "prefix", "suffix"] } }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": { "field": { "const": "sourceHost" } },
            "required": ["field"]
          },
          "then": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "maxLength": 255,
                "pattern": "^(?:[a-z0-9](?:[a-z0-9.-]{0,253}[a-z0-9])?|\\[[0-9a-f:.]+\\])$"
              }
            }
          }
        }
      ]
    },
    "condition2": {
      "anyOf": [
        { "$ref": "#/$defs/leaf" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "$ref": "#/$defs/leaf" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "$ref": "#/$defs/leaf" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/leaf" } }
        }
      ]
    },
    "condition3": {
      "anyOf": [
        { "$ref": "#/$defs/leaf" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "$ref": "#/$defs/condition2" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "$ref": "#/$defs/condition2" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition2" } }
        }
      ]
    },
    "condition4": {
      "anyOf": [
        { "$ref": "#/$defs/leaf" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "$ref": "#/$defs/condition3" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "$ref": "#/$defs/condition3" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition3" } }
        }
      ]
    },
    "action": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["hide"],
          "properties": { "hide": { "const": true } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["keep"],
          "properties": { "keep": { "const": true } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag"],
          "properties": { "tag": { "type": "string", "minLength": 1, "maxLength": 64 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["markRead"],
          "properties": { "markRead": { "const": true } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["follow"],
          "properties": { "follow": { "const": true } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["toRead"],
          "properties": { "toRead": { "const": true } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["alert"],
          "properties": { "alert": { "const": true } }
        }
      ]
    }
  }
}
