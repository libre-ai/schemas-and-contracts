{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.libre-ai.fr/schemas/artifact-manifest-signatures.v1.schema.json",
  "title": "Libre AI Artifact Manifest Signatures v1",
  "description": "Detached Ed25519 signatures over one artifact-manifest.v1 document. Semantics: contracts/artifact-manifest-signatures-v1/SEMANTICS.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "signatures"],
  "properties": {
    "schemaVersion": { "const": "libre-ai.artifact-manifest-signatures.v1" },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["signingKeyId", "signature"],
        "properties": {
          "signingKeyId": { "$ref": "signing-keys.v1.schema.json#/$defs/signingKeyId" },
          "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{85}[AQgw]$" }
        }
      }
    }
  }
}
